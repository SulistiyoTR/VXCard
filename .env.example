# Copy to .env.local and fill in. Also set these in the Vercel project.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic Console → API keys. Billed per use (~$1 / 500 words). Backend only.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-haiku-4-5
ANTHROPIC_MODEL=claude-haiku-4-5

# Used for OAuth redirects in production (e.g. https://vx-card.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
