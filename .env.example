# Copy to .env.local and fill in. Also set these in the Vercel project.

# --- Supabase → Project Settings → API ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (server-only, bypasses RLS) — used by the daily cron job
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic Console → API keys. Billed per use (~$1 / 500 words). Backend only. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Dictionary (SPEC 1.2). dictionaryapi.dev is the default and needs no key,
#     but it is unreachable from some Vercel regions. Merriam-Webster Learner's
#     is the fallback: free key from dictionaryapi.com/register (1000 req/day).
#     Set DICTIONARY_PRIMARY=mw to make Merriam-Webster the primary source. ---
MERRIAM_WEBSTER_KEY=
DICTIONARY_PRIMARY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Web Push (SPEC 6.3). Generate with: npx web-push generate-vapid-keys ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Vercel Cron auth. Any long random string; Vercel sends it as a Bearer token. ---
CRON_SECRET=
